---
import { timeline } from '../data/profile';
---

<div class="groups">
  {
    timeline.map((group) => (
      <section class="group" aria-labelledby={`tl-${group.title}`}>
        <h3 class="group-title" id={`tl-${group.title}`}>
          {group.title}
        </h3>
        <ol class="timeline" role="list">
          {group.items.map((item) => (
            <li class:list={['item', { upcoming: item.upcoming }]}>
              <p class="when">
                {item.upcoming && <span class="label">Upcoming</span>}
                {item.when}
              </p>
              <div class="body">
                <h4>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h4>
                <p class="org">{item.org}</p>
                {item.text && <p class="text">{item.text}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .groups {
    display: grid;
    gap: var(--s-7);
    max-width: 52rem;
  }
  .group-title {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--text-muted);
    margin-bottom: var(--s-4);
  }
  .timeline {
    display: grid;
  }
  .item {
    position: relative;
    display: grid;
    gap: var(--s-1);
    padding: 0 0 var(--s-6) var(--s-5);
    border-left: 1px solid var(--border);
  }
  .item:last-child {
    padding-bottom: 0;
  }
  .item::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0.45rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--border-strong);
  }
  .upcoming::before {
    border-color: var(--accent);
    background: var(--accent);
  }
  .when {
    font-size: var(--step--1);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    align-items: baseline;
  }
  .label {
    color: var(--accent);
    font-weight: 500;
  }
  h4 {
    margin: 0;
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.3;
  }
  h4 a {
    color: var(--text);
    text-decoration-color: var(--border-strong);
  }
  h4 a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .org {
    color: var(--text-muted);
  }
  .text {
    margin-top: var(--s-2);
    max-width: var(--measure);
  }
  @media (min-width: 720px) {
    .group-title {
      padding-left: calc(11rem + var(--s-5) * 2);
    }
    .item {
      grid-template-columns: 11rem 1fr;
      gap: var(--s-5);
      border-left: 0;
      padding-left: 0;
    }
    .item::before {
      left: calc(11rem + var(--s-5) / 2 - 4px);
    }
    .item::after {
      content: '';
      position: absolute;
      left: calc(11rem + var(--s-5) / 2);
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--border);
      z-index: -1;
    }
    .item:last-child::after {
      bottom: auto;
      height: 0.9rem;
    }
    .body {
      padding-left: var(--s-5);
    }
    .when {
      flex-direction: column;
      gap: 0;
      text-align: right;
      align-items: flex-end;
    }
  }
</style>
