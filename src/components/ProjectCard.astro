---
import type { Project } from '../lib/projects';
import StatusBadge from './StatusBadge.astro';
import Icon from './Icon.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { title, summary, context, period, team, status, stack } = project.data;
const titleId = `card-${project.id}`;
---

<li class="card">
  <a href={`/projects/${project.id}/`} class="link" aria-labelledby={titleId}>
    <div class="meta">
      <span>{context} · {period}</span>
      <StatusBadge status={status} />
    </div>
    <h3 id={titleId}>{title}</h3>
    <p class="summary">{summary}</p>
    <p class="team">{team}</p>
    <ul class="tags" role="list" aria-label="Stack">
      {stack.map((s) => <li class="tag">{s}</li>)}
    </ul>
    <span class="more">View project <Icon name="arrow" size={16} /></span>
  </a>
</li>

<style>
  .card {
    display: flex;
  }
  .link {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: border-color var(--ease);
  }
  .link:hover {
    border-color: var(--accent);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  h3 {
    font-size: var(--step-1);
    margin-top: var(--s-1);
  }
  .summary {
    color: var(--text);
  }
  .team {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .tags {
    margin-top: var(--s-1);
  }
  .more {
    margin-top: auto;
    padding-top: var(--s-3);
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--accent);
  }
  .more :global(.icon) {
    transition: transform var(--ease);
  }
  .link:hover .more :global(.icon) {
    transform: translateX(3px);
  }
</style>
