---
interface Props {
  status: 'shipped' | 'in progress';
}
const { status } = Astro.props;
---

<span class:list={['status', status === 'shipped' ? 'shipped' : 'progress']}>
  <span class="dot" aria-hidden="true"></span>{status === 'shipped' ? 'Shipped' : 'In progress'}
</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    line-height: 1.4;
    white-space: nowrap;
    color: var(--text-muted);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: 1.5px solid currentColor;
  }
  .shipped {
    color: var(--accent);
  }
  .shipped .dot {
    background: currentColor;
  }
</style>
